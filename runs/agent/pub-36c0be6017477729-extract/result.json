"},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"invalid_evidence","message":"Evidence proposal has an invalid field or source location","path":""},{"code":"unlinked_assertions","message":"61 emitted assertions have no evidence link","path":""},{"code":"source_incomplete","message":"Source preparation reported unavailable content","path":""}],"parse_status":"recovered","provider":{"error_code":null,"finish_reason":"stop","input_tokens":36401,"latency_ms":57470.85039992817,"mode":"live","model":"openai/gpt-4o-2024-08-06","output_tokens":7425,"request_id":"a131cf0245884a7c937483c8c0379352","response_sha256":"e65744b9baec32e33443934646afaa5bbcba310c0747534c6ea71fd37fb770bf","status":"ok"},"repairs":["code_fences_removed"],"response_truncated":false,"schema_issues":[],"schema_status":"valid","snapshot":{"canonical_json":"{\"bibliographic\":{\"abstract\":\"We report the structural, magnetic, and magnetocaloric properties of Co2Cr1−xTixAl (x = 0– 0.5) Heusler alloys for spintronic and magnetic refrigerator applications. Room temperature X-ray diffraction and neutron diffraction patterns along with Rietveld refinements confirm that the samples are of single phase and possess a cubic structure. Interestingly, magnetic susceptibly measurements indicate a second order phase transition from paramagnetic to ferromagnetic where the Curie temperature (TC) of Co2CrAl increases from 330 K to 445 K with Ti substitution. Neutron powder diffraction data of the x = 0 sample across the magnetic phase transition taken in a large temperature range confirm the structural stability and exclude the possibility of antiferromagnetic ordering. The saturation magnetization of the x = 0 sample is found to be 8000 emu/mol (1.45 µB/f.u.) at 5 K, which is in good agreement with the value (1.35 ± 0.05 µB/f.u.) obtained from the Rietveld analysis of the neutron powder diffraction pattern measured at temperature of 4 K. By analysing the temperature dependence of the neutron data of the x = 0 sample, we find that the change in the intensity of the most intense Bragg peak (220) is consistent with the magnetization behavior with temperature. Furthermore, an enhancement of change in the magnetic entropy and relative cooling power values has been observed for the x = 0.25 sample. Interestingly, the critical behavior analysis across the second order magnetic phase transition and extracted exponents (β ≈ 0.496, γ ≈ 1.348, and δ ≈ 3.71 for the x = 0.25 sample) suggest the presence of long-range ordering, which deviates towards 3D Heisenberg type interactions above TC, consistent with the interaction range value σ.\",\"affiliations\":[{\"id\":\"aff_1\",\"label\":\"1\",\"text\":\"Department of Physics, Indian Institute of Technology Delhi, Hauz Khas, New Delhi-110016, India\"},{\"id\":\"aff_2\",\"label\":\"2\",\"text\":\"School of Physics, The University of New South Wales, Kensington, 2052 NSW, Sydney, Australia\"},{\"id\":\"aff_3\",\"label\":\"3\",\"text\":\"Australian Centre for Neutron Scattering, Australian Nuclear Science and Technology Organisation (ANSTO), New Illawarra Road, Lucas Heights NSW 2234, Australia\"},{\"id\":\"aff_4\",\"label\":\"4\",\"text\":\"UGC-DAE Consortium for Scientific Research, Trombay, Mumbai-400085 India.\"}],\"arxiv_id\":null,\"authors\":[{\"affiliation_refs\":[\"aff_1\"],\"email\":null,\"full_name\":\"Priyanka Nehla\",\"id\":\"author_1\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_2\"],\"email\":null,\"full_name\":\"Yousef Kareri\",\"id\":\"author_2\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_1\"],\"email\":null,\"full_name\":\"Guru Dutt Gupt\",\"id\":\"author_3\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_3\"],\"email\":null,\"full_name\":\"James Hester\",\"id\":\"author_4\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_4\"],\"email\":null,\"full_name\":\"P. D. Babu\",\"id\":\"author_5\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_2\"],\"email\":null,\"full_name\":\"Clemens Ulrich\",\"id\":\"author_6\",\"is_corresponding\":false,\"orcid\":null},{\"affiliation_refs\":[\"aff_1\"],\"email\":\"rsdhaka@physics.iitd.ac.in\",\"full_name\":\"R. S. Dhaka\",\"id\":\"author_7\",\"is_corresponding\":true,\"orcid\":null}],\"doi\":null,\"funding\":[{\"funder\":\"BRNS\",\"grant_id\":\"34/20/12/2015/BRNS\"},{\"funder\":\"department of science & technology (DST), India\",\"grant_id\":\"IA/INDO-AUST/F19/2017/1887\"},{\"funder\":\"Australian Research Council (ARC)\",\"grant_id\":\"DP160100545\"}],\"keywords\":[],\"language\":\"en\",\"publication_date\":\"2019-09-19\",\"publisher\":null,\"subtitle\":null,\"title\":\"Neutron diffraction and magnetic properties of Co2Cr1−xTixAl Heusler alloys\",\"url\":null,\"venue\":null},\"datasets\":[{\"dataset_description\":\"Powder XRD measurements were performed at room temperature on a Panalytical diffractometer using the Cu Kα (λ = 1.5406[˚] A) radiation.\",\"dataset_name\":\"powder X-ray diffraction (XRD)\",\"facility_refs\":[],\"id\":\"dataset_1\",\"measurement_mode\":[],\"measurement_technique\":\"powder X-ray diffraction\",\"purpose\":\"measurement\",\"sample_refs\":[\"sample_1\"]},{\"dataset_description\":\"Neutron powder diffraction experiments have been performed using the high intensity neutron diffractometer WOMBAT and the high resolution diffractometer ECHIDNA at the OPAL research reactor at ANSTO, Australia.\",\"dataset_name\":\"neutron powder diffraction (ND)\",\"facility_refs\":[\"facility_1\"],\"id\":\"dataset_2\",\"measurement_mode\":[],\"measurement_technique\":\"neutron powder diffraction\",\"purpose\":\"measurement\",\"sample_refs\":[\"sample_1\"]}],\"document_overview\":{\"has_figures\":true,\"has_references\":true,\"has_tables\":false,\"section_headings\":[\"INTRODUCTION\",\"EXPERIMENTAL DETAILS\",\"RESULTS AND DISCUSSION\",\"CONCLUSIONS\",\"ACKNOWLEDGMENTS\"]},\"facilities\":[{\"id\":\"facility_1\",\"name\":\"OPAL research reactor at ANSTO, Australia\"}],\"samples\":[{\"chemical_composition\":\"Co2Cr1−xTixAl\",\"id\":\"sample_1\",\"sample_description\":\"Polycrystalline samples synthesized from high purity elements Co