# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.
# The scripts in scripts/ auto-load this file, so values set here don't
# need to be manually re-exported each shell/tmux session.

# Hosted-model keys. The variable names match api_key_env in the published
# GPT and Mistral configs; configure the endpoint in a local config copy.
OPENAI_API_KEY=your-api-key-here
MISTRAL_API_KEY=your-api-key-here

# Key for the local vLLM server (Qwen + local Gemma configs). You choose
# this value; it is passed to `vllm serve --api-key` and sent by the client.
# Any non-empty string works as long as both sides match.
QWEN_API_KEY=choose-any-value

# Hugging Face read token — NOT required for any model currently in the
# matrix. Both Qwen3.5 and google/gemma-4-31B-it are ungated (Apache 2.0),
# so downloads work anonymously. Set this only if you hit HF rate limits,
# or if a future gated model is added.
# HF_TOKEN=hf_...

# Optional: redirect the Hugging Face weight cache off a quota-limited home
# directory. Set before downloading if `df -h $HOME` looks tight.
# HF_HOME=/path/to/bulk/storage/huggingface
